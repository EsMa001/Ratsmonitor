OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
IMPORT_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Portable import runner only: production HTTPS origin (never put tokens in URLs)
SITE_URL=
# Optional comma-separated subset. Default: the 43 existing areas with articles.
IMPORT_REGIONS=
# scheduled respects cooldown; manual explicitly retries despite cooldown.
IMPORT_TRIGGER=scheduled

# SHA-256 of the one-time admin activation code; never commit the code itself.
ADMIN_SETUP_HASH=

# Optional service credential for manually importing the fixed Billerbeck test.
# Set as a runtime secret; never commit a value. Does not permit arbitrary writes.
PREPARED_ANALYSIS_TOKEN=

# Optional read-only service credential for full article-data export.
DATA_EXPORT_TOKEN=
