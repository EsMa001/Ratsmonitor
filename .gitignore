# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

/.source-cache/
/.env

/.oparl-cache/
!.env.example

*.tsbuildinfo

/tmp/

# Import work files; only the reviewed export belongs in Git.
/data/nrw/
/data/nrw.json

# Lokale Protokolle
*.log

# Lokale Zugangskonfiguration
.dev.vars*

.dev.vars*

/.local-backups/
/ratsmonitor-data*.json*

# Interne Strategiepapiere, nicht im oeffentlichen Repo
docs/strategie/
