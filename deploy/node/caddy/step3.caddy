# Schritt 3 (eigene Domain, Start der Testphase): Basic-Auth entfällt, die Zugangssperre der App (RM_ACCESS=invite)
# schützt. sslip.io bleibt für das Übergangsfenster (Übernahme der Browserdaten, 14 Tage), danach die Weiterleitung unten.
http://localhost:8080, http://127.0.0.1:8080 {
	bind 127.0.0.1
	import app_proxy
}

DOMAIN.example {
	header X-Robots-Tag "noindex, nofollow"
	header Strict-Transport-Security "max-age=31536000"
	import public_site
	import mcp_routes
	import app_proxy
}

187-7-72-52.sslip.io {
	header X-Robots-Tag "noindex, nofollow"
	import public_site
	import mcp_routes
	import app_proxy
	# nach dem Übergangsfenster statt der beiden import-Zeilen:
	# redir https://DOMAIN.example{uri} permanent
}
