# Schritt 0 und 1 (sofort, und mit Release A): Admin-Kennung nur noch im Tunnel; die öffentliche Site sperrt die
# Administration. Basic-Auth bleibt als äußerer Zaun, bis die Zugangssperre (RM_ACCESS=invite) geprüft ist.
http://localhost:8080, http://127.0.0.1:8080 {
	bind 127.0.0.1
	import app_proxy_legacy_identity
}

187-7-72-52.sslip.io {
	header X-Robots-Tag "noindex, nofollow"
	import public_site
	basicauth {
		plenara HASH_NUR_AUF_DEM_SERVER
	}
	import app_proxy
}
