# Gemeinsame Bausteine der Caddy-Fassungen (requirements/konten-konzept.md 6.3). Die Fassungen je Schritt importieren sie:
#   cat deploy/node/caddy/snippets.caddy deploy/node/caddy/step0.caddy > /etc/caddy/Caddyfile   (Hash von Hand ergänzen)
# `encode` nur für statische Pfade (siehe app_proxy): vinext komprimiert HTML und API selbst und lässt den Suchstrom
# (application/x-ndjson) bewusst unkomprimiert.

# Proxy zur App mit den Cache-Regeln der statischen Dateien (siehe deploy/node/Caddyfile)
(app_proxy) {
	# Statische Dateien komprimieren (Messung 17.10.2026, docs/qualitaet/frontend-effizienz-2026-10-17.md): vinext komprimiert
	# nur HTML und API-Antworten, JS, CSS und Kartendaten kamen roh (de_map.json 2,4 MB, JS 1 MB). Nur diese Pfade, damit
	# der Suchstrom (application/x-ndjson unter /api/) unberührt bleibt; schon komprimierte Antworten lässt encode aus.
	@static_assets path /_next/static/* /data/* /geo/*
	encode @static_assets zstd gzip
	@static_data path /data/* /geo/*
	header @static_data {
		Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		defer
	}
	@static_fonts path /fonts/*
	header @static_fonts {
		Cache-Control "public, max-age=2592000"
		defer
	}
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
		transport http {
			keepalive 30s
		}
	}
}

# Übergang (Schritt 0 und 1): nur im Tunnel setzt Caddy noch die alte Admin-Kennung (ADMIN_LEGACY_HEADER)
(app_proxy_legacy_identity) {
	# Statische Dateien komprimieren (Messung 17.10.2026, docs/qualitaet/frontend-effizienz-2026-10-17.md): vinext komprimiert
	# nur HTML und API-Antworten, JS, CSS und Kartendaten kamen roh (de_map.json 2,4 MB, JS 1 MB). Nur diese Pfade, damit
	# der Suchstrom (application/x-ndjson unter /api/) unberührt bleibt; schon komprimierte Antworten lässt encode aus.
	@static_assets path /_next/static/* /data/* /geo/*
	encode @static_assets zstd gzip
	@static_data path /data/* /geo/*
	header @static_data {
		Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		defer
	}
	@static_fonts path /fonts/*
	header @static_fonts {
		Cache-Control "public, max-age=2592000"
		defer
	}
	reverse_proxy 127.0.0.1:3000 {
		header_up Oai-Authenticated-User-Id {$RM_ADMIN_USER_ID}
		header_up Oai-Authenticated-User-Email {$RM_ADMIN_EMAIL}
		header_up -Oai-Authenticated-User-Full-Name
		header_up -Oai-Authenticated-User-Full-Name-Encoding
		flush_interval -1
		transport http {
			keepalive 30s
		}
	}
}

# Jede öffentliche Site: keine Admin-Kennung und keine Prerender-Kopfzeilen von außen, Sicherheitskopfzeilen.
# Die Administration prüft die App selbst: Rolle admin, Anmeldung jünger als 7 Tage und über die öffentliche Adresse der
# zweite Faktor (Code aus der Authenticator-App, requirements/konten-konzept.md 6.4).
# Kunden-MCP (ratsmonitor-mcp.service, 127.0.0.1:3002) und die OAuth-Endpunkte der App: ohne Seitenpasswort erreichbar,
# sie prüfen selbst (Schlüssel oder Token, PKCE). In der Site vor basicauth importieren und basicauth auf @site_password
# begrenzen. Die Zustimmung (/verbinden) bleibt hinter dem Passwort und verlangt die Anmeldung.
(mcp_routes) {
	@mcp_service path /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/* /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/*
	handle @mcp_service {
		reverse_proxy 127.0.0.1:3002 {
			flush_interval -1
		}
	}
	@site_password not path /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/* /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/* /oauth/authorize /oauth/token /oauth/register /oauth/revoke
}

(public_site) {
	request_header -Oai-Authenticated-User-Id
	request_header -Oai-Authenticated-User-Email
	request_header -Oai-Authenticated-User-Full-Name
	request_header -Oai-Authenticated-User-Full-Name-Encoding
	request_header -X-Prerender-Revalidate
	request_header -X-Prerender-Revalidate-If-Generated
	# Weitergeleitete Kopfzeilen setzt reverse_proxy selbst neu; von außen kommende verwerfen
	request_header -X-Forwarded-Proto
	request_header -X-Forwarded-Host
	request_header -X-Forwarded-For
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
