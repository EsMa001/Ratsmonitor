# Täglich 01:00 Uhr Systemzeit (timedatectl: Europe/Berlin; TZ=UTC aus der Umgebungsdatei gilt nur im Prozess):
# bundesweiter Lauf (ratsmonitor-import-nightly.service). Ein Lauf dauerte am 10.10.2026 2,8 h; --max-minutes 240 beendet
# ihn spätestens gegen 05:00. Die Sicherung um 03:30 (VACUUM INTO, nur lesend) und die Wortliste um 04:15 (eigene Sperre)
# vertragen sich damit.
[Unit]
Description=Ratsmonitor Importprozess, nachts (Zeit im Admin-Reiter, Standard 01:00 Uhr)

[Timer]
# Seit dem Zeitplaner (scripts/schedule.mjs) fragt der Timer alle 10 Minuten; ob der Lauf dran ist, entscheidet die Einstellung
# im Admin-Reiter „Jobs & Zeitpläne“ (Standard 01:00 Uhr deutscher Zeit).
OnCalendar=*:0/10
Persistent=false
AccuracySec=1min
Unit=ratsmonitor-import-nightly.service

[Install]
WantedBy=timers.target
