# Sofortstart aus der Administration (server/integrations/job-trigger.mjs): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/rule-texts, systemd startet dann ratsmonitor-rule-texts.service (scripts/schedule.mjs sieht den Wunsch).
# Läuft der Dienst schon, passiert nichts; der laufende Job erledigt Wünsche selbst oder der nächste Timer-Aufruf.
[Unit]
Description=Ratsmonitor: rule-texts sofort starten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/rule-texts
Unit=ratsmonitor-rule-texts.service

[Install]
WantedBy=multi-user.target
