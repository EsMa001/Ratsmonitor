# Anhalten aus der Administration (server/integrations/job-trigger.mjs, triggerStop): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/stop-pdf-job, systemd hält dann ratsmonitor-pdf-job.service an (ratsmonitor-stop@.service).
[Unit]
Description=Ratsmonitor: pdf-job anhalten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/stop-pdf-job
Unit=ratsmonitor-stop@pdf-job.service

[Install]
WantedBy=multi-user.target
