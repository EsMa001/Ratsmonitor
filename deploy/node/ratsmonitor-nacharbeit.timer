# Alle 10 Minuten den Zeitplaner fragen (ratsmonitor-nacharbeit.service); ob nacharbeit dran ist, steht im Admin-Reiter „Jobs & Zeitpläne“.
[Unit]
Description=Ratsmonitor nacharbeit, Zeitplaner

[Timer]
OnCalendar=*:0/10
Persistent=false
AccuracySec=1min
Unit=ratsmonitor-nacharbeit.service

[Install]
WantedBy=timers.target
