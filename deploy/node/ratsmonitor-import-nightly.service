# Nächtlicher bundesweiter Lauf: legt einen Auftrag über alle angebundenen Quellen an (eine Woche zurück) und arbeitet
# ihn ab. Ist noch ein Auftrag offen, wird der fortgesetzt. Läuft gerade der 10-Minuten-Prozess, wartet systemd nicht:
# beide Einheiten teilen sich den Auftrag über die Sperren in der Datenbank (jedes Gebiet genau einmal).
[Unit]
Description=Ratsmonitor Importprozess, nächtlicher Lauf
OnFailure=ratsmonitor-notify@%n.service
After=network-online.target ratsmonitor.service
Wants=network-online.target

[Service]
Type=oneshot
User=ratsmonitor
Group=ratsmonitor
WorkingDirectory=/srv/ratsmonitor/app/current
EnvironmentFile=/srv/ratsmonitor/ratsmonitor.env
Environment=IMPORT_BUSY_TIMEOUT_MS=30000
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=5h
# Gestartet über den Zeitplaner (scripts/schedule.mjs, Admin-Reiter „Jobs & Zeitpläne“): er prüft Ein/Aus und Zeit aus der
# Datenbank und vermerkt den Lauf; der Befehl selbst steht in server/integrations/schedules.mjs.
ExecStart=/usr/bin/node --no-warnings scripts/schedule.mjs import-nightly
MemoryHigh=7G
MemoryMax=8G
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ratsmonitor/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Konten: dieser Job sieht die Kontendatei nicht (requirements/konten-konzept.md 3.2)
InaccessiblePaths=-/srv/ratsmonitor/accounts
