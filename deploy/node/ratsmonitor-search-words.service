# Wortliste der Suche nachführen (scripts/refresh-search-words.mjs) über den Zeitplaner (scripts/schedule.mjs search-words,
# Admin-Reiter „Jobs & Zeitpläne“, Standard 04:20 Uhr). Ersetzt den Eintrag in /etc/cron.d/ratsmonitor; Protokoll wie bisher
# in backups/search-words.log.
[Unit]
Description=Ratsmonitor Wortliste der Suche
After=ratsmonitor.service

[Service]
Type=oneshot
User=ratsmonitor
Group=ratsmonitor
WorkingDirectory=/srv/ratsmonitor/app/current
EnvironmentFile=/srv/ratsmonitor/ratsmonitor.env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h
ExecStart=/usr/bin/node --no-warnings scripts/schedule.mjs search-words
StandardOutput=append:/srv/ratsmonitor/backups/search-words.log
StandardError=append:/srv/ratsmonitor/backups/search-words.log
MemoryHigh=7G
MemoryMax=8G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ratsmonitor/data /srv/ratsmonitor/backups
