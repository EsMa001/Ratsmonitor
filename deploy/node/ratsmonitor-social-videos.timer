# Alle 10 Minuten den Zeitplaner fragen (ratsmonitor-social-videos.service); ob social-videos dran ist, steht im Admin-Reiter „Jobs & Zeitpläne“.
[Unit]
Description=Ratsmonitor social-videos, Zeitplaner

[Timer]
OnCalendar=*:0/10
Persistent=false
AccuracySec=1min
Unit=ratsmonitor-social-videos.service

[Install]
WantedBy=timers.target
