# Anhalten aus der Administration (server/integrations/job-trigger.mjs): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/stop-nacharbeit, systemd hält dann ratsmonitor-nacharbeit.service an (ratsmonitor-stop@.service).
[Unit]
Description=Ratsmonitor: nacharbeit anhalten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/stop-nacharbeit
Unit=ratsmonitor-stop@nacharbeit.service

[Install]
WantedBy=multi-user.target
