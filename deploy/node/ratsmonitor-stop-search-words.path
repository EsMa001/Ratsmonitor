# Anhalten aus der Administration (server/integrations/job-trigger.mjs, triggerStop): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/stop-search-words, systemd hält dann ratsmonitor-search-words.service an (ratsmonitor-stop@.service).
[Unit]
Description=Ratsmonitor: search-words anhalten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/stop-search-words
Unit=ratsmonitor-stop@search-words.service

[Install]
WantedBy=multi-user.target
