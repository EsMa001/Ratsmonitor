# Anhalten aus der Administration (server/integrations/job-trigger.mjs, triggerStop): /srv/ratsmonitor/data/trigger/stop-betrieb
[Unit]
Description=Ratsmonitor: betrieb anhalten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/stop-betrieb
Unit=ratsmonitor-stop@betrieb.service

[Install]
WantedBy=multi-user.target
