# Altbestand (scripts/altbestand.mjs über den Zeitplaner, Job „altbestand“): führt aus, was auf der Seite „Altbestand“ angefordert ist
# (rückwirkender Abruf mit Extraktion und Verarbeitung, alte Fehler erneut versuchen), 10 bis 22 Uhr. Protokoll in backups/altbestand.log.
[Unit]
Description=Ratsmonitor Altbestand (auf Anforderung, 10–22 Uhr)
OnFailure=ratsmonitor-notify@%n.service
After=network-online.target ratsmonitor.service
Wants=network-online.target

[Service]
Type=oneshot
User=ratsmonitor
Group=ratsmonitor
WorkingDirectory=/srv/ratsmonitor/app/current
EnvironmentFile=/srv/ratsmonitor/ratsmonitor.env
Environment=IMPORT_BUSY_TIMEOUT_MS=30000
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h
TimeoutStopSec=30
ExecStart=/usr/bin/node --no-warnings scripts/schedule.mjs altbestand
StandardOutput=append:/srv/ratsmonitor/backups/altbestand.log
StandardError=append:/srv/ratsmonitor/backups/altbestand.log
MemoryHigh=7G
MemoryMax=8G
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ratsmonitor/data /srv/ratsmonitor/backups
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Konten: dieser Job sieht die Kontendatei nicht (requirements/konten-konzept.md 3.2)
InaccessiblePaths=-/srv/ratsmonitor/accounts
