# Sofortstart aus der Administration (server/integrations/job-trigger.mjs): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/pdf-nightly, systemd startet dann ratsmonitor-pdf-nightly.service (scripts/schedule.mjs sieht den Wunsch).
# Läuft der Dienst schon, passiert nichts; der laufende Job erledigt Wünsche selbst oder der nächste Timer-Aufruf.
[Unit]
Description=Ratsmonitor: pdf-nightly sofort starten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/pdf-nightly
Unit=ratsmonitor-pdf-nightly.service

[Install]
WantedBy=multi-user.target
