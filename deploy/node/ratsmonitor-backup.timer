# Alle 10 Minuten den Zeitplaner fragen (ratsmonitor-backup.service); ob backup dran ist, steht im Admin-Reiter „Jobs & Zeitpläne“.
[Unit]
Description=Ratsmonitor backup, Zeitplaner

[Timer]
OnCalendar=*:0/10
Persistent=false
AccuracySec=1min
Unit=ratsmonitor-backup.service

[Install]
WantedBy=timers.target
