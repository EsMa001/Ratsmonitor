# /srv/ratsmonitor/accounts/accounts.env (root:root, Rechte 600). Nur ratsmonitor.service und ratsmonitor-accounts.service
# laden diese Datei (zweites EnvironmentFile); Importe, PDF-Jobs und Wortliste sehen sie nicht (requirements/konten-konzept.md 3.2).
# Kontendatei: eigene SQLite-Datei, nie in Entwicklerkopien oder im Datenexport
ACCOUNTS_FILE=/srv/ratsmonitor/accounts/accounts.sqlite
# Geheimnis für Zählschlüssel (HMAC der Adressen), zufällig, mindestens 32 Zeichen: openssl rand -base64 48
ACCOUNTS_SECRET=
# Schlüssel des Mailanbieters (MAIL_TRANSPORT=http)
MAIL_API_KEY=
# Öffentlicher age-Schlüssel für die verschlüsselte Sicherung der Kontendatei (age-keygen; der private Schlüssel liegt
# offline bei Max und Nico, nie auf dem Server)
ACCOUNTS_AGE_RECIPIENT=
