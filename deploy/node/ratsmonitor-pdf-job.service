# Aufträge aus dem Admin-Reiter „PDF-Ablage“ (scripts/pdf-store/job.mjs): alle 10 Minuten und per Knopf nachsehen, ob etwas
# angefordert ist; ohne Auftrag endet der Dienst sofort. Zwei Bahnen nebeneinander (Laden, OCR), je Bahn einer zur Zeit; der
# Dienst bleibt, solange etwas läuft, und startet frei gewordene Bahnen nach. Hält die nächtliche Kette die Bahn „Laden“,
# warten deren Aufträge. Höchstens 12 Stunden (job.mjs startet nur, was in der Restzeit fertig wird).
[Unit]
Description=Ratsmonitor PDF-Ablage, Auftrag aus der Administration
After=network-online.target ratsmonitor.service
Wants=network-online.target

[Service]
Type=oneshot
User=ratsmonitor
Group=ratsmonitor
WorkingDirectory=/srv/ratsmonitor/app/current
EnvironmentFile=/srv/ratsmonitor/ratsmonitor.env
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=12h
# Gestartet über den Zeitplaner (scripts/schedule.mjs, Admin-Reiter „Jobs & Zeitpläne“): er prüft Ein/Aus und Zeit aus der
# Datenbank und vermerkt den Lauf; der Befehl selbst steht in server/integrations/schedules.mjs.
ExecStart=/usr/bin/node --no-warnings scripts/schedule.mjs pdf-job
MemoryHigh=6G
MemoryMax=7G
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ratsmonitor/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
