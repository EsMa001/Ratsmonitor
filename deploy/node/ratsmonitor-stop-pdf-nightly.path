# Anhalten aus der Administration (server/integrations/job-trigger.mjs, triggerStop): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/stop-pdf-nightly, systemd hält dann ratsmonitor-pdf-nightly.service an (ratsmonitor-stop@.service).
[Unit]
Description=Ratsmonitor: pdf-nightly anhalten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/stop-pdf-nightly
Unit=ratsmonitor-stop@pdf-nightly.service

[Install]
WantedBy=multi-user.target
