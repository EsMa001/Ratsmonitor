# Nacharbeit (scripts/nacharbeit.mjs über den Zeitplaner, Job „nacharbeit“): fällige Einträge des Fehlerspeichers (work_failures)
# erneut versuchen, alle 30 Minuten zwischen 09:00 und 23:00 Uhr, höchstens 20 Minuten je Lauf. Protokoll in backups/nacharbeit.log.
[Unit]
Description=Ratsmonitor Nacharbeit (Fehlerspeicher, 09–23 Uhr)
OnFailure=ratsmonitor-notify@%n.service
After=network-online.target ratsmonitor.service
Wants=network-online.target

[Service]
Type=oneshot
User=ratsmonitor
Group=ratsmonitor
WorkingDirectory=/srv/ratsmonitor/app/current
EnvironmentFile=/srv/ratsmonitor/ratsmonitor.env
Environment=IMPORT_BUSY_TIMEOUT_MS=30000
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1h
TimeoutStopSec=30
ExecStart=/usr/bin/node --no-warnings scripts/schedule.mjs nacharbeit
StandardOutput=append:/srv/ratsmonitor/backups/nacharbeit.log
StandardError=append:/srv/ratsmonitor/backups/nacharbeit.log
MemoryHigh=7G
MemoryMax=8G
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ratsmonitor/data /srv/ratsmonitor/backups
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Konten: dieser Job sieht die Kontendatei nicht (requirements/konten-konzept.md 3.2)
InaccessiblePaths=-/srv/ratsmonitor/accounts
