# Anhalten aus der Administration (server/integrations/job-trigger.mjs): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/stop-ocr, systemd hält dann ratsmonitor-ocr.service an (ratsmonitor-stop@.service).
[Unit]
Description=Ratsmonitor: ocr anhalten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/stop-ocr
Unit=ratsmonitor-stop@ocr.service

[Install]
WantedBy=multi-user.target
