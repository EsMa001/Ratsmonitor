# Vorlage für /srv/ratsmonitor/ratsmonitor.env (Rechte 600, Eigentümer root; der Dienst liest sie beim Start).
# Leere Werte gelten als nicht gesetzt.

# Datenbankdatei (SQLite, WAL). Ohne Wert zeigt die Seite nur den mitgelieferten Stand.
DATABASE_FILE=/srv/ratsmonitor/data/ratsmonitor.sqlite
# Nur lesen (1) oder lesen und schreiben (leer)
DATABASE_READONLY=

# Der Node-Server lauscht nur intern; Caddy nimmt die Anfragen von außen an.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Öffentliche Adresse für Links und Metadaten
SITE_URL=

# Einmalige Admin-Freischaltung: SHA-256 (hex) des Freischaltcodes. Nach der Freischaltung wirkungslos.
# Alternativ ohne Code: node scripts/bind-admin-owner.mjs <Datenbank> <Nutzer-ID>
ADMIN_SETUP_HASH=

# Optional
IMPORT_TOKEN=
DATA_EXPORT_TOKEN=
PREPARED_ANALYSIS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
