# Vorlage für /srv/ratsmonitor/ratsmonitor.env (Rechte 600, Eigentümer root; der Dienst liest sie beim Start).
# Leere Werte gelten als nicht gesetzt. Änderungen wirken nach `systemctl restart ratsmonitor`.

# Datenbankdatei (SQLite, WAL). Ohne Wert oder bei fehlender Datei zeigt die Seite nur den mitgelieferten Stand.
DATABASE_FILE=/srv/ratsmonitor/data/ratsmonitor.sqlite
# Nur lesen (1) oder lesen und schreiben (leer)
DATABASE_READONLY=
# Wie lange der Server auf eine Sperre eines anderen Prozesses wartet (ms); der Server steht währenddessen.
DATABASE_BUSY_TIMEOUT_MS=5000
# Abfragen ab dieser Dauer (ms) ins Protokoll schreiben
DATABASE_SLOW_MS=1000

# Der Node-Server lauscht nur intern; Caddy nimmt die Anfragen von außen an.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
# Wie Cloudflare Workers: Datumsangaben ohne eigene Zeitzone rechnen in UTC
TZ=UTC
# Caddy davor: Protokoll (http/https) und Host aus X-Forwarded-*, sonst scheitern Admin-Aktionen an der Herkunftsprüfung
VINEXT_TRUST_PROXY=1
NODE_OPTIONS=--max-old-space-size=6144 --disable-warning=ExperimentalWarning

# Öffentliche Adresse für Links und Metadaten
SITE_URL=

# Einmalige Admin-Freischaltung: SHA-256 (hex) des Freischaltcodes. Nach der Freischaltung wirkungslos.
# Einfacher auf dem eigenen Server: node scripts/bind-admin-owner.mjs <Datenbank> <Nutzer-ID aus Caddy>
ADMIN_SETUP_HASH=

# Optional
IMPORT_TOKEN=
DATA_EXPORT_TOKEN=
PREPARED_ANALYSIS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
