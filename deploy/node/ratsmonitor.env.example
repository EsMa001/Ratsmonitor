# Vorlage für /srv/ratsmonitor/ratsmonitor.env (Rechte 600, Eigentümer root; der Dienst liest sie beim Start).
# Leere Werte gelten als nicht gesetzt. Änderungen wirken nach `systemctl restart ratsmonitor`.

# Datenbankdatei (SQLite, WAL). Ohne Wert oder bei fehlender Datei bricht der Start ab (serve.mjs). Nur ohne Wert und
# mit RM_ALLOW_NO_DB=1 (Tests) startet er ohne Datenbank und zeigt den mitgelieferten Stand vom September.
DATABASE_FILE=/srv/ratsmonitor/data/ratsmonitor.sqlite
# Nur lesen (1) oder lesen und schreiben (leer)
DATABASE_READONLY=
# Wie lange der Server auf eine Sperre eines anderen Prozesses wartet (ms); der Server steht währenddessen.
DATABASE_BUSY_TIMEOUT_MS=5000
# Abfragen ab dieser Dauer (ms) ins Protokoll schreiben
DATABASE_SLOW_MS=1000

# Der Node-Server lauscht nur intern; Caddy nimmt die Anfragen von außen an.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
# Wie Cloudflare Workers: Datumsangaben ohne eigene Zeitzone rechnen in UTC
TZ=UTC
# Caddy davor: Protokoll (http/https) und Host aus X-Forwarded-*, sonst scheitern Admin-Aktionen an der Herkunftsprüfung
VINEXT_TRUST_PROXY=1
NODE_OPTIONS="--max-old-space-size=6144 --disable-warning=ExperimentalWarning"

# Öffentliche Adresse für Links und Metadaten; mit Konten auch für die Links in Mails (Pflicht bei RM_ACCESS=invite)
SITE_URL=

# Konten (requirements/konten-konzept.md). Kontendatei, Geheimnis und Mailschlüssel stehen NICHT hier, sondern in
# /srv/ratsmonitor/accounts/accounts.env (Vorlage accounts.env.example), die nur der Webdienst und der Kontojob laden.
# Zugang: invite = nur angemeldete Konten (geschlossene Testphase), open = Seite offen. Leer gilt open (mit Warnung).
RM_ACCESS=invite
# Admin nur über diese Hosts (Tunnel, http). Andere Hosts bekommen keine Admin-Rechte, auch mit Admin-Konto.
ADMIN_HOSTS=127.0.0.1:8080,localhost:8080
# Übergang: 1 = alter Admin-Weg über die Caddy-Kopfzeilen bleibt zusätzlich (nur bis zum Umschalten, Abschnitt 14.2)
ADMIN_LEGACY_HEADER=0
# Mailversand: http (Anbieter-API), log (nur Protokoll), outbox (Test-Postfach in der Kontendatei)
MAIL_TRANSPORT=log
MAIL_API_URL=
MAIL_FROM="Plenara <anmeldung@example.org>"
MAIL_REPLY_TO=
# Warnungen aus dem Kontobetrieb (Kontingent erschöpft, Mails hängen)
OPERATOR_EMAIL=

# Einmalige Admin-Freischaltung: SHA-256 (hex) des Freischaltcodes. Nach der Freischaltung wirkungslos.
# Einfacher auf dem eigenen Server: node scripts/bind-admin-owner.mjs <Datenbank> <Nutzer-ID aus Caddy>
ADMIN_SETUP_HASH=

# Optional
# Mindestens 16 Zeichen; kürzere Werte gelten als nicht gesetzt (die internen Routen antworten 401).
IMPORT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# PDF-Ablage (docs/betrieb/node-server.md, „PDF-Ablage, Texte, Fakten“): Originale und Textfassungen der Hauptdokumente.
# Gesetzt liest der Importprozess Dokumente zuerst dort und legt neu geladene ab; die nächtliche Kette
# (ratsmonitor-pdf-nightly) füllt sie. Leer: alles wie bisher, nur aus dem Netz.
RM_PDF_STORE=/srv/ratsmonitor/data/pdf-store
# OCR (nur die nächtliche Kette): Ordner mit node_modules von tesseract.js und @napi-rs/canvas (außerhalb des Releases,
# einmal einrichten: mkdir -p /srv/ratsmonitor/ocr-tools && cd /srv/ratsmonitor/ocr-tools && npm install tesseract.js@7 @napi-rs/canvas)
OCR_TOOLS=/srv/ratsmonitor/ocr-tools
# Sprachdaten (deu.traineddata, beim ersten Lauf geladen); muss beschreibbar sein
OCR_CACHE=/srv/ratsmonitor/data/ocr-cache
