# Sofortstart aus der Administration (server/integrations/job-trigger.mjs): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/startseite-trends, systemd startet dann ratsmonitor-startseite-trends.service (scripts/schedule.mjs sieht den Wunsch).
# Läuft der Dienst schon, passiert nichts; der laufende Job erledigt Wünsche selbst oder der nächste Timer-Aufruf.
[Unit]
Description=Ratsmonitor: startseite-trends sofort starten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/startseite-trends
Unit=ratsmonitor-startseite-trends.service

[Install]
WantedBy=multi-user.target
