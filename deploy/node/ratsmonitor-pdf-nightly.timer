# Täglich 05:30 Uhr Systemzeit, nach dem bundesweiten Import (01:00, spätestens gegen 05:00 fertig), der Sicherung (03:30) und
# der Wortliste (04:15). Die Kette läuft höchstens drei Stunden (--minutes 180), also bis etwa 08:30.
[Unit]
Description=Ratsmonitor PDF-Ablage, nachts (Zeit im Admin-Reiter, Standard 05:30 Uhr)

[Timer]
# Seit dem Zeitplaner (scripts/schedule.mjs) fragt der Timer alle 10 Minuten; ob der Lauf dran ist, entscheidet die Einstellung
# im Admin-Reiter „Jobs & Zeitpläne“ (Standard 05:30 Uhr deutscher Zeit).
OnCalendar=*:0/10
Persistent=false
AccuracySec=1min
Unit=ratsmonitor-pdf-nightly.service

[Install]
WantedBy=timers.target
