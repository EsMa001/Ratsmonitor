# /etc/ratsmonitor/mcp.env (root:ratsmonitor, 640). Gelesen von ratsmonitor-mcp.service (Kunden-MCP) und
# ratsmonitor.service (Web-App: OAuth-Anmeldung für den Kunden-MCP). Docs: docs/betrieb/claude-mcp-einbindung.md.
# Geheimnis erzeugen: openssl rand -base64 48 | tr -d '\n'  (nur hier, nie in Git, Chats oder Tickets)
MCP_TOKEN_SECRET=
# Kundendatei des Betreibers (scripts/mcp-customers.mjs init); Gebiete, Schlüssel (nur SHA-256), Konten (nur IDs)
MCP_CUSTOMERS_FILE=/srv/ratsmonitor/config/mcp/customers.json
# Nur für den MCP-Dienst: Inhaltsdatei (nur lesend) und öffentliche Adresse ohne Pfad
MCP_DATABASE_FILE=/srv/ratsmonitor/data/ratsmonitor.sqlite
MCP_ISSUER=https://plenara.de
MCP_PORT=3002
