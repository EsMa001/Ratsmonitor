# Alle 10 Minuten den Zeitplaner fragen (ratsmonitor-altbestand.service); ob altbestand dran ist, steht im Admin-Reiter „Jobs & Zeitpläne“.
[Unit]
Description=Ratsmonitor altbestand, Zeitplaner

[Timer]
OnCalendar=*:0/10
Persistent=false
AccuracySec=1min
Unit=ratsmonitor-altbestand.service

[Install]
WantedBy=timers.target
