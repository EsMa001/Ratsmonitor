# Alle 10 Minuten den Zeitplaner fragen (ratsmonitor-search-words.service); ob search-words dran ist, steht im Admin-Reiter „Jobs & Zeitpläne“.
[Unit]
Description=Ratsmonitor search-words, Zeitplaner

[Timer]
OnCalendar=*:0/10
Persistent=false
AccuracySec=1min
Unit=ratsmonitor-search-words.service

[Install]
WantedBy=timers.target
