# Anhalten aus der Administration (server/integrations/job-trigger.mjs, triggerStop): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/stop-import, systemd hält dann ratsmonitor-import.service an (ratsmonitor-stop@.service).
[Unit]
Description=Ratsmonitor: import anhalten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/stop-import
Unit=ratsmonitor-stop@import.service

[Install]
WantedBy=multi-user.target
