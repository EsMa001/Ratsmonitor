# Importprozess neben dem Webserver (Code-Analyse A14): arbeitet den gespeicherten Abrufauftrag ab, ohne Browser und ohne
# die Website anzuhalten. Gestartet vom Timer (ratsmonitor-import.timer, alle 10 Minuten) oder von Hand:
#   systemctl start ratsmonitor-import        offenen Auftrag abarbeiten (ohne offenen Auftrag endet er sofort)
# Einen Auftrag anlegen: in der Administration „im Hintergrund abrufen“, oder der nächtliche Lauf
# (ratsmonitor-import-nightly.service), oder von Hand als ratsmonitor:
#   cd /srv/ratsmonitor/app/current && set -a && . /srv/ratsmonitor/ratsmonitor.env && set +a && node dist/standalone/worker/import-worker.mjs --create sources --window 1w
# Installieren:
#   cp deploy/node/ratsmonitor-import*.service deploy/node/ratsmonitor-import*.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now ratsmonitor-import.timer ratsmonitor-import-nightly.timer
# Protokoll: journalctl -u ratsmonitor-import -u ratsmonitor-import-nightly
[Unit]
Description=Ratsmonitor Importprozess
After=network-online.target ratsmonitor.service
Wants=network-online.target

[Service]
Type=oneshot
User=ratsmonitor
Group=ratsmonitor
WorkingDirectory=/srv/ratsmonitor/app/current
EnvironmentFile=/srv/ratsmonitor/ratsmonitor.env
# Länger auf Schreibsperren des Webprozesses warten als dieser (5 s); der Importprozess hat Zeit. Eigene Variable, weil
# die Umgebungsdatei DATABASE_BUSY_TIMEOUT_MS für den Dienst setzt und Environment= hier überschreiben würde.
Environment=IMPORT_BUSY_TIMEOUT_MS=30000
# Hinter dem Webserver zurückstehen: CPU und Platte mit niedriger Priorität
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Ein bundesweiter Lauf dauert etwa drei Stunden; --max-minutes beendet den Prozess vorher (der Auftrag bleibt, der
# nächste Lauf des Timers macht weiter), TimeoutStartSec ist die harte Grenze
TimeoutStartSec=5h
# Gestartet über den Zeitplaner (scripts/schedule.mjs, Admin-Reiter „Jobs & Zeitpläne“): er prüft Ein/Aus und Zeit aus der
# Datenbank und vermerkt den Lauf; der Befehl selbst steht in server/integrations/schedules.mjs.
ExecStart=/usr/bin/node --no-warnings scripts/schedule.mjs import
# Speicher: Heap 6 GB wie bisher im Webprozess (große Gebiete lesen bis 1 GB je Schritt, A4); der Dienst ist auf 8 GB
# begrenzt, zusammen bleibt bei 16 GB wenig für den Seitencache: beide Grenzen sind Obergrenzen, keine Reservierung
MemoryHigh=7G
MemoryMax=8G
LimitNOFILE=65536
# Absicherung wie der Dienst: nur der Datenordner ist beschreibbar
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ratsmonitor/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Konten: dieser Job sieht die Kontendatei nicht (requirements/konten-konzept.md 3.2)
InaccessiblePaths=-/srv/ratsmonitor/accounts
