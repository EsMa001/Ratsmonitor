# Anhalten aus der Administration (server/integrations/job-trigger.mjs, triggerStop): /srv/ratsmonitor/data/trigger/stop-notify
[Unit]
Description=Ratsmonitor: notify anhalten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/stop-notify
Unit=ratsmonitor-stop@notify.service

[Install]
WantedBy=multi-user.target
