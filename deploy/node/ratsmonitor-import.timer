# Zeitplan des Importprozesses (ratsmonitor-import.service):
# - alle 10 Minuten: einen offenen Auftrag abarbeiten (die Admin-Seite legt ihn mit „im Hintergrund abrufen“ an);
#   ohne offenen Auftrag endet der Prozess sofort.
# - täglich 01:00 Uhr: bundesweiter Lauf über alle angebundenen Quellen, eine Woche zurück (zweite Einheit
#   ratsmonitor-import-nightly.service/.timer). Installieren: siehe ratsmonitor-import.service.
[Unit]
Description=Ratsmonitor Importprozess, alle 10 Minuten

[Timer]
OnBootSec=5min
OnUnitInactiveSec=10min
AccuracySec=1min
Unit=ratsmonitor-import.service

[Install]
WantedBy=timers.target
