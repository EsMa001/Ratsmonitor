#!/usr/bin/env bash
# Passwort des Mailpostfachs (SMTP) ohne Echo in /etc/ratsmonitor/accounts.env eintragen, Base64-kodiert (SMTP_PASSWORD_B64)
# Installieren: install -m 700 deploy/node/ratsmonitor-smtp-password /usr/local/bin/ ; Aufruf (auch aus PowerShell): ssh -t ratsmonitor ratsmonitor-smtp-password
set -euo pipefail
F=/etc/ratsmonitor/accounts.env
read -rs -p "Passwort fuer $(sed -n "s/^SMTP_USER=//p" "$F" | tail -1): " P; echo
[ -n "$P" ] || { echo "Leer, nichts gespeichert"; exit 1; }
sed -i "/^SMTP_PASSWORD_B64=/d" "$F"
printf "SMTP_PASSWORD_B64=%s\n" "$(printf %s "$P" | base64 -w0)" >> "$F"
unset P; chmod 600 "$F"; echo "gespeichert"
