# Sofortstart aus der Administration (server/integrations/job-trigger.mjs): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/search-words, systemd startet dann ratsmonitor-search-words.service (scripts/schedule.mjs sieht den Wunsch).
# Läuft der Dienst schon, passiert nichts; der laufende Job erledigt Wünsche selbst oder der nächste Timer-Aufruf.
[Unit]
Description=Ratsmonitor: search-words sofort starten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/search-words
Unit=ratsmonitor-search-words.service

[Install]
WantedBy=multi-user.target
