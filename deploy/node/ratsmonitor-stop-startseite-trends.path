# Anhalten aus der Administration (server/integrations/job-trigger.mjs, triggerStop): ein Knopfdruck schreibt
# /srv/ratsmonitor/data/trigger/stop-startseite-trends, systemd hält dann ratsmonitor-startseite-trends.service an (ratsmonitor-stop@.service).
[Unit]
Description=Ratsmonitor: startseite-trends anhalten, wenn die Administration es anfordert

[Path]
PathModified=/srv/ratsmonitor/data/trigger/stop-startseite-trends
Unit=ratsmonitor-stop@startseite-trends.service

[Install]
WantedBy=multi-user.target
