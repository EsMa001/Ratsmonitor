#!/usr/bin/env bash
# Kontenverwaltung auf dem Server (scripts/accounts/manage.mjs) mit den richtigen Rechten und Einstellungen.
# Installieren: install -m 755 deploy/node/ratsmonitor-accounts /usr/local/bin/ratsmonitor-accounts
# Beispiel (Adresse über die Eingabe, nicht als Argument): ratsmonitor-accounts invite --email-stdin --note "Gespräch 14.10."
# Die Einstellungsdateien werden gelesen, nie als Shell ausgeführt (root ruft dieses Skript auf).
set -euo pipefail
KEYS="ACCOUNTS_FILE ACCOUNTS_SECRET SITE_URL MAIL_TRANSPORT MAIL_API_URL MAIL_API_KEY MAIL_FROM MAIL_REPLY_TO OPERATOR_EMAIL RM_ACCESS"
ENVS=()
for file in /srv/ratsmonitor/ratsmonitor.env /etc/ratsmonitor/accounts.env; do
  [ -f "$file" ] || continue
  for key in $KEYS; do
    value="$(sed -n "s/^$key=//p" "$file" | tail -1 | sed 's/^"\(.*\)"$/\1/')"
    [ -n "$value" ] && ENVS+=("$key=$value")
  done
done
cd /srv/ratsmonitor/app/current
exec sudo -u ratsmonitor env "${ENVS[@]}" node --no-warnings scripts/accounts/manage.mjs "$@"
