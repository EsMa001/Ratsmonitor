     "ende": 272.9,
     "schritte": [
      {
       "szene": "x-atlas",
       "schritt": "start",
       "clip": "x-atlas"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Der Atlas zeigt, worüber beraten wird, wo und wie viel, nach zehn Themen.",
