     "ende": 76.6,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "liste",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Jede Zeile sagt Ihnen, worum es geht, wer berät und wann.",
