   "kapitel": "Wie viel? Der Atlas",
   "start": 269.0,
   "ende": 291.9,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Plenara X wertet die Beratungen aller Räte gemeinsam aus.",
