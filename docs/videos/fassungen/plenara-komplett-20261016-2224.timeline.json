     "ende": 161.6,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "abo",
       "clip": "kalender"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "So behalten Sie den Überblick, ohne zu suchen. Plenara meldet sich.",
     "start": 162.4,
     "ende": 166.3,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "abo",
       "clip": "kalender"
      }
     ]
    }
   ]
  },
