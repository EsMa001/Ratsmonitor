     "ende": 157.3,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "glocke",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Und am Tag einer Sitzung in Ihren Gebieten kommt eine E-Mail.",
