 "kapitel": [
  {
   "nr": 1,
   "id": "einleitung",
   "kapitel": "Wissen, was vor Ort entschieden wird, bevor es bekannt ist",
   "start": 7.2,
   "ende": 36.0,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Was wird in Räten gerade beraten, das Sie betrifft?",
     "start": 7.7,
     "ende": 10.3,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "kopf",
       "clip": "startseite"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Plenara zeigt, was in Ihren Kommunen beraten wird: Beschlüsse und Beratungen an einem Ort.",
     "start": 11.1,
     "ende": 16.2,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "marke",
       "clip": "startseite"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Zahl zeigt, wie viele Berichte aus Räten und Ausschüssen in den letzten 30 Tagen dazugekommen sind.",
     "start": 17.0,
     "ende": 23.0,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "zahl",
       "clip": "startseite"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Ein Begriff genügt, zum Beispiel Wärmeplanung, und die Karte zeigt sofort, wo darüber beraten wird.",
     "start": 23.8,
     "ende": 29.4,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "suche",
       "clip": "startseite"
      }
     ]
    },
    {
     "nr": 5,
     "kern": true,
     "text": "Jede Angabe führt zur Originalunterlage, und Alarme melden Neues per E-Mail.",
     "start": 30.2,
     "ende": 34.9,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "artikel",
       "clip": "startseite"
      }
     ]
    }
   ]
  },
  {
   "nr": 2,
   "id": "suchen",
   "kapitel": "Ein Begriff. Ganz Deutschland. Sofort auf der Karte.",
   "start": 36.0,
   "ende": 69.1,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Die Suche gilt immer für ganz Deutschland. Einen Ort können Sie aber wählen.",
     "start": 36.5,
     "ende": 40.4,
     "schritte": [
      {
       "szene": "suche-eingabe",
       "schritt": "eingabe",
       "clip": "suche-eingabe@thema-waermeplanung@vorsuche-ja"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Die Karte zeigt, wo darüber beraten wird: in vierzehn Bundesländern.",
     "start": 41.2,
     "ende": 45.3,
     "schritte": [
      {
       "szene": "suche-eingabe",
       "schritt": "karte",
       "clip": "suche-eingabe@thema-waermeplanung@vorsuche-ja"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Zahl an jedem Gebiet verrät, wie viele Einträge es dort gibt.",
     "start": 46.1,
     "ende": 49.6,
     "schritte": [
      {
       "szene": "suche-eingabe",
       "schritt": "karte",
       "clip": "suche-eingabe@thema-waermeplanung@vorsuche-ja"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Ein Klick zeigt die Beschlüsse dieses Gebiets. In Stuttgart sind es dreizehn.",
     "start": 50.4,
     "ende": 54.3,
     "schritte": [
      {
       "szene": "karte-gebiet",
       "schritt": "zoom",
       "clip": "karte-gebiet@ort-stuttgart@thema-waermeplanung"
      },
      {
       "szene": "karte-gebiet",
       "schritt": "klick",
       "clip": "karte-gebiet@ort-stuttgart@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Die Heatmap zeigt auf einen Blick, wo sich ein Thema häuft.",
     "start": 55.1,
     "ende": 58.1,
     "schritte": [
      {
       "szene": "karte-heatmap",
       "schritt": "heatmap",
       "clip": "karte-heatmap@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Tippen Sie einen Ort, zum Beispiel Stuttgart, und Plenara erkennt ihn sofort.",
     "start": 58.9,
     "ende": 63.0,
     "schritte": [
      {
       "szene": "suche-ort",
       "schritt": "tippen",
       "clip": "suche-ort@ort-stuttgart"
      },
      {
       "szene": "suche-ort",
       "schritt": "ergebnis",
       "clip": "suche-ort@ort-stuttgart"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Von ganz Deutschland bis in Ihre Gemeinde. Eine Suche, eine Karte.",
     "start": 63.8,
     "ende": 68.0,
     "schritte": [
      {
       "szene": "suche-ort",
       "schritt": "ergebnis",
       "clip": "suche-ort@ort-stuttgart"
      }
     ]
    }
   ]
  },
  {
   "nr": 3,
   "id": "liste-artikel",
   "kapitel": "Aus über zehntausend Einträgen den Überblick behalten",
   "start": 69.1,
   "ende": 105.8,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Zu einem Thema gibt es mehr als eintausend Einträge, jeder mit Gremium und Datum.",
     "start": 69.6,
     "ende": 74.3,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "liste",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Jede Zeile sagt Ihnen, worum es geht, wer berät und wann.",
     "start": 75.1,
     "ende": 78.9,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "zeile",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Bei vielen Vorgängen sehen Sie sogar den Stand: jede Beratung mit Datum und Gremium.",
     "start": 79.7,
     "ende": 84.6,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "zeitstrahl",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Sortieren Sie nach Datum oder Relevanz, kompakt oder ausführlich.",
     "start": 85.4,
     "ende": 89.6,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "liste",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Ein Klick öffnet den ganzen Artikel.",
     "start": 90.4,
     "ende": 92.4,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "artikel",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Eine Kurzfassung unter dem Titel sagt Ihnen sofort, worum es geht.",
     "start": 93.2,
     "ende": 96.9,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "artikel",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Darunter stehen der Verlauf durch die Gremien und alle Unterlagen.",
     "start": 97.7,
     "ende": 100.9,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "verlauf",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 8,
     "kern": false,
     "text": "Vom Überblick zur Originalunterlage in wenigen Klicks.",
     "start": 101.7,
     "ende": 104.7,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "quelle",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    }
   ]
  },
  {
   "nr": 4,
   "id": "filter",
   "kapitel": "Gezielt eingrenzen, bis nur das Passende übrig bleibt",
   "start": 105.8,
   "ende": 137.7,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Zu viele Treffer? Dann grenzen Sie sie ein.",
     "start": 106.3,
     "ende": 108.8,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "offen",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Wollen Sie nur ganze Wörter, schalten Sie den exakten Begriff ein.",
     "start": 109.6,
     "ende": 113.1,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "exakt",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Wählen Sie Zeitraum, Thema und Status, zum Beispiel beschlossen oder in Beratung.",
     "start": 113.9,
     "ende": 118.7,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "zeitraum",
       "clip": "filter-fenster"
      },
      {
       "szene": "filter-fenster",
       "schritt": "thema",
       "clip": "filter-fenster"
      },
      {
       "szene": "filter-fenster",
       "schritt": "status",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Karte und Liste passen sich sofort an.",
     "start": 119.5,
     "ende": 121.7,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "karte",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Ihre Auswahl steht als Marken unter der Suchleiste, ein Klick entfernt sie wieder.",
     "start": 122.5,
     "ende": 127.0,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "marken",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Mehrere Begriffe verknüpfen Sie wahlweise mit „alle“ oder „einer davon“.",
     "start": 127.8,
     "ende": 131.6,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "kombi",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "So wird aus mehr als eintausend Einträgen genau die Auswahl, die Sie brauchen.",
     "start": 132.4,
     "ende": 136.6,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "marken",
       "clip": "filter-fenster"
      }
     ]
    }
   ]
  },
  {
   "nr": 5,
   "id": "alarme",
   "kapitel": "Nichts verpassen, ohne zu suchen",
   "start": 137.7,
   "ende": 164.8,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Sie wollen nichts verpassen, aber nicht jeden Tag suchen?",
     "start": 138.2,
     "ende": 140.9,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "herz",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Speichern Sie Ihre Suche mit dem Herz.",
     "start": 141.7,
     "ende": 143.7,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "herz",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Im Konto schalten Sie die Glocke ein.",
     "start": 144.5,
     "ende": 146.2,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "konto",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Eine E-Mail meldet, sobald es zu Ihrer Suche neue Treffer gibt.",
     "start": 147.0,
     "ende": 150.5,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "glocke",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Wie oft Sie benachrichtigt werden, legen Sie bei jeder Suche fest.",
     "start": 151.3,
     "ende": 154.7,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "glocke",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Und am Tag einer Sitzung in Ihren Gebieten kommt eine E-Mail.",
     "start": 155.5,
     "ende": 159.0,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "abo",
       "clip": "kalender"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "So behalten Sie den Überblick, ohne zu suchen. Plenara meldet sich.",
     "start": 159.8,
     "ende": 163.7,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "abo",
       "clip": "kalender"
      }
     ]
    }
   ]
  },
  {
   "nr": 6,
   "id": "kalender",
   "kapitel": "Keine Sitzung verpassen",
   "start": 164.8,
   "ende": 187.3,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Wann tagt der Rat, der Sie interessiert?",
     "start": 165.3,
     "ende": 167.4,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "oeffnen",
       "clip": "kalender"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Im Kalender sehen Sie anstehende Sitzungen auf einen Blick.",
     "start": 168.2,
     "ende": 171.5,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "oeffnen",
       "clip": "kalender"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Wählen Sie Ihre Gebiete, einen Ort oder Kreis, auch mehrere zugleich.",
     "start": 172.3,
     "ende": 176.3,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "gebiete",
       "clip": "kalender"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Jeder Tag mit einer Sitzung ist markiert, ein Klick zeigt Gremium und Themen.",
     "start": 177.1,
     "ende": 181.5,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "tag",
       "clip": "kalender"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Mit „Kalender abonnieren“ übernehmen Sie die Termine in Ihren eigenen Kalender.",
     "start": 182.3,
     "ende": 186.2,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "abo",
       "clip": "kalender"
      }
     ]
    }
   ]
  },
  {
   "nr": 7,
   "id": "konto",
   "kapitel": "Alles Gespeicherte an einem Ort",
   "start": 187.3,
   "ende": 210.6,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Ihre Suchen, Artikel und Alarme an einem Ort.",
     "start": 187.8,
     "ende": 190.9,
     "schritte": [
      {
       "szene": "konto",
       "schritt": "menue",
       "clip": "konto"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Über das Personensymbol öffnen Sie Ihr Konto und die Abmeldung.",
     "start": 191.7,
     "ende": 195.2,
     "schritte": [
      {
       "szene": "konto",
       "schritt": "menue",
       "clip": "konto"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Im Profil tragen Sie Name und E-Mail ein und sehen Ihren Tarif.",
     "start": 196.0,
     "ende": 199.8,
     "schritte": [
      {
       "szene": "konto",
       "schritt": "profil",
       "clip": "konto"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Alles Gespeicherte erreichen Sie über die Symbole in der Kopfzeile: Suchen, Artikel und Kalender.",
     "start": 200.6,
     "ende": 205.9,
     "schritte": [
      {
       "szene": "konto",
       "schritt": "symbole",
       "clip": "konto"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Es bleibt erhalten, auch wenn Sie später wiederkommen.",
     "start": 206.7,
     "ende": 209.5,
     "schritte": [
      {
       "szene": "konto",
       "schritt": "symbole",
       "clip": "konto"
      }
     ]
    }
   ]
  },
  {
   "nr": 8,
   "id": "abdeckung",
   "kapitel": "Ist Ihre Gemeinde dabei? Das sehen Sie offen",
   "start": 210.6,
   "ende": 238.1,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Ist Ihre Gemeinde dabei?",
     "start": 211.1,
     "ende": 212.7,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Die Seite Datenabdeckung zeigt es offen.",
     "start": 213.5,
     "ende": 215.8,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Heute sind es mehr als neunhunderttausend Einträge aus über sechstausend Gemeinden.",
     "start": 216.6,
     "ende": 221.1,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Suchen Sie Ihre Gemeinde oder Ihren Kreis und sehen Sie, wie aktuell der Stand dort ist.",
     "start": 221.9,
     "ende": 226.7,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "suche",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Auch der letzte Abruf der Daten steht dabei.",
     "start": 227.5,
     "ende": 230.2,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "abruf",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Fehlt etwas, melden Sie es uns direkt.",
     "start": 231.0,
     "ende": 233.3,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Wir sagen offen, was schon dabei ist und was noch fehlt.",
     "start": 234.1,
     "ende": 237.0,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    }
   ]
  },
  {
   "nr": 9,
   "id": "x-atlas",
   "kapitel": "Wie viel? Der Atlas",
   "start": 238.1,
   "ende": 261.3,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Plenara X bietet elf Auswertungen über die Beratungen aller Räte.",
     "start": 238.6,
     "ende": 242.3,
     "schritte": [
      {
       "szene": "x-atlas",
       "schritt": "start",
       "clip": "x-atlas"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Der Atlas zeigt, worüber beraten wird, wo und wie viel, nach zehn Themen.",
     "start": 243.1,
     "ende": 247.9,
     "schritte": [
      {
       "szene": "x-atlas",
       "schritt": "start",
