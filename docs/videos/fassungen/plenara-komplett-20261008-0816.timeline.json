     "ende": 391.9,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "start",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Der Knowledge Graph zeigt es als Netz aus verwandten Begriffen, Themenfeldern, Gremien und Ländern.",
     "start": 392.7,
     "ende": 398.3,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "netz",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Knoten ziehen und anklicken können Sie selbst.",
