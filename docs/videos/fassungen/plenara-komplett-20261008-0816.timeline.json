     "ende": 112.4,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "karte",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Ihre Auswahl steht als Marken unter der Suchleiste, ein Klick entfernt sie wieder.",
     "start": 113.2,
     "ende": 117.7,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "marken",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Mehrere Begriffe verknüpfen Sie wahlweise mit „alle“ oder „einer davon“.",
     "start": 118.5,
     "ende": 122.3,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "kombi",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "So wird aus mehr als zweitausend Einträgen genau die Auswahl, die Sie brauchen.",
     "start": 123.1,
     "ende": 127.4,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "marken",
       "clip": "filter-fenster"
      }
     ]
    }
   ]
  },
  {
   "nr": 5,
   "id": "alarme",
   "kapitel": "Nichts verpassen, ohne zu suchen",
   "start": 128.5,
   "ende": 166.2,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Sie wollen nichts verpassen, aber nicht jeden Tag suchen?",
