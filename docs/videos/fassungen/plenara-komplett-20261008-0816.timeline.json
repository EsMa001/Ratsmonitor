     "ende": 406.7,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "gremien",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 5,
     "kern": true,
     "text": "So entdecken Sie Zusammenhänge, nach denen Sie nie gesucht hätten.",
