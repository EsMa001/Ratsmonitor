     "ende": 99.5,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "offen",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Wollen Sie nur ganze Wörter, schalten Sie den exakten Begriff ein.",
