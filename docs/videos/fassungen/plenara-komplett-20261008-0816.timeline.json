    },
    {
     "nr": 3,
     "kern": true,
     "text": "Heute sind es mehr als neunhunderttausend Einträge aus über sechstausend Gemeinden.",
     "start": 246.3,
     "ende": 250.8,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Suchen Sie Ihre Gemeinde oder Ihren Kreis und sehen Sie, wie aktuell der Stand dort ist.",
     "start": 251.6,
     "ende": 256.4,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "suche",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Auch der letzte Abruf der Daten steht dabei.",
     "start": 257.2,
     "ende": 259.9,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "abruf",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Fehlt etwas, melden Sie es uns direkt.",
     "start": 260.7,
     "ende": 263.0,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Wir sagen offen, was schon dabei ist und was noch fehlt.",
     "start": 263.8,
     "ende": 266.6,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    }
   ]
  },
  {
   "nr": 10,
   "id": "diffusion",
   "kapitel": "Sehen, wie sich ein Thema ausbreitet",
   "start": 267.7,
   "ende": 308.4,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Eine Suche zeigt einzelne Beschlüsse. Plenara X zeigt, wie sich ein Thema im ganzen Land bewegt.",
     "start": 268.2,
     "ende": 273.9,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "start",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Im Datenbestand taucht Wärmeplanung im September zweitausendfünfundzwanzig zum ersten Mal auf.",
     "start": 274.7,
     "ende": 280.3,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "karte",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Diffusionsanalyse läuft dann als Zeitraffer auf der Karte.",
     "start": 281.1,
     "ende": 284.4,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "zeitraffer",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Nach fünf Monaten war die Hälfte der Gebiete erreicht.",
     "start": 285.2,
     "ende": 288.1,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "kennzahlen",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Von zehn auf neunzig Prozent der Gebiete dauerte es elf Monate.",
     "start": 288.9,
     "ende": 292.7,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "zehnneunzig",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Das Diagramm zeigt den Verlauf Monat für Monat, ein Klick setzt die Karte auf das Datum.",
     "start": 293.4,
     "ende": 298.4,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "diagramm",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Ganz anders Hitzeschutz: Im September kamen dreihundertneunundneunzig neue Gebiete dazu.",
     "start": 299.2,
     "ende": 304.2,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "gegenbeispiel",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 8,
     "kern": false,
     "text": "Auch die Bundesländer lassen sich vergleichen.",
     "start": 305.0,
     "ende": 307.3,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "laender",
       "clip": "diffusion"
      }
     ]
    }
   ]
  },
  {
   "nr": 11,
   "id": "entscheidungen",
   "kapitel": "Wie Vorgänge ausgehen",
   "start": 308.4,
   "ende": 340.0,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Wie gehen Vorgänge aus: beschlossen, vertagt oder abgelehnt?",
     "start": 308.9,
     "ende": 312.5,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "start",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Bei Wärmeplanung sind fast fünfundneunzig Prozent der entschiedenen Vorgänge beschlossen.",
     "start": 313.3,
     "ende": 317.8,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "raten",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "vier Prozent wurden vertagt, ein Prozent abgelehnt.",
     "start": 318.6,
     "ende": 321.6,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "rateno",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Hälfte der Vorgänge war nach siebzehn Tagen entschieden.",
     "start": 322.4,
     "ende": 325.3,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "dauer",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Wo das Abstimmungsergebnis bekannt ist, waren fast neunundsechzig Prozent einstimmig.",
     "start": 326.1,
     "ende": 330.9,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "votes",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Dabei zählen nur Vorgänge mit bekanntem Status, das sind einundvierzig Prozent der Einträge. Das zeigt Plenara offen an.",
     "start": 331.7,
     "ende": 338.9,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "status",
       "clip": "entscheidungen"
      }
     ]
    }
   ]
  },
  {
   "nr": 12,
   "id": "trends",
   "kapitel": "Neues früh erkennen",
   "start": 340.0,
   "ende": 362.2,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Was kommt in Ihren Kommunen gerade auf?",
     "start": 340.5,
     "ende": 342.5,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "start",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Die Trendanalyse vergleicht die letzten neunzig Tage mit dem Zeitraum davor.",
     "start": 343.2,
     "ende": 347.1,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "zeitraum",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "In der Trendkarte ist jeder Punkt ein Begriff: rechts häufiger, oben stärker gewachsen.",
     "start": 347.9,
     "ende": 352.4,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "karte",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Rangliste zeigt zu jedem Begriff die Verlaufskurve und den Faktor des Anstiegs.",
     "start": 353.2,
     "ende": 357.7,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "rangliste",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Auch die Themenfelder lassen sich vergleichen.",
     "start": 358.5,
     "ende": 361.1,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "themenfelder",
       "clip": "trends"
      }
     ]
    }
   ]
  },
  {
   "nr": 13,
   "id": "vergleich",
   "kapitel": "Orte vergleichen",
   "start": 362.2,
   "ende": 389.4,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Wie steht Ihr Ort im Vergleich?",
     "start": 362.7,
     "ende": 364.7,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "start",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Der Gebietsvergleich stellt zwei bis vier Orte nebeneinander, hier Münster und Osnabrück.",
     "start": 365.5,
     "ende": 370.6,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "orte",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Sie vergleichen Themenprofil, Stand der Vorlagen und aktivste Gremien.",
     "start": 371.4,
     "ende": 375.6,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "profil",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Dazu kommen typische und gemeinsame Begriffe.",
     "start": 376.4,
     "ende": 379.0,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "begriffe",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Als Maßstab dienen alle Gebiete.",
     "start": 379.8,
     "ende": 381.8,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "massstab",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Die Zahlen zeigen, was im Bestand steht, nicht automatisch, wie aktiv die Politik vor Ort ist.",
     "start": 382.6,
     "ende": 388.3,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "hinweis",
       "clip": "vergleich"
      }
     ]
    }
   ]
  },
  {
   "nr": 14,
   "id": "graph",
   "kapitel": "Zusammenhänge entdecken",
   "start": 389.4,
   "ende": 415.8,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Womit hängt Wärmeplanung zusammen?",
