     "ende": 414.7,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "hinweis",
       "clip": "graph"
      }
     ]
    }
   ]
  },
  {
   "nr": 15,
   "id": "gremiennetz",
   "kapitel": "Den Weg durch die Gremien verstehen",
   "start": 415.8,
   "ende": 445.3,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Welchen Weg nimmt ein Vorgang durch die Gremien?",
     "start": 416.3,
     "ende": 418.5,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "start",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Das Gremiennetz zeigt, wo Vorgänge beginnen, welche Gremien dazwischen liegen und wo sie entschieden werden.",
     "start": 419.3,
     "ende": 424.9,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "netz",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Ausgewertet sind einhundertfünfundfünfzig Vorgänge, die durch mindestens zwei Gremien gingen.",
     "start": 425.7,
     "ende": 430.8,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "pfeile",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Pfeile zeigen die Übergänge und wie lange ein Übergang dauert.",
     "start": 431.6,
     "ende": 434.9,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "dauer",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Darunter sehen Sie die Rollen im Netz: Einstieg, Durchlauf und Entscheidung.",
     "start": 435.7,
     "ende": 439.9,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "arten",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "So erkennen Sie, an welcher Stelle Sie sich in ein Thema einbringen können.",
     "start": 440.7,
     "ende": 444.2,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "fazit",
       "clip": "gremiennetz"
      }
     ]
    }
   ]
  },
