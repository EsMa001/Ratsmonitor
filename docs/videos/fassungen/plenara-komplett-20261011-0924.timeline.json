       "szene": "filter-fenster",
       "schritt": "thema",
       "clip": "filter-fenster"
      },
      {
       "szene": "filter-fenster",
       "schritt": "status",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Karte und Liste passen sich sofort an.",
