       "szene": "postfach",
       "schritt": "wochenbericht",
       "clip": "postfach@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 8,
     "kern": false,
     "text": "Und am Tag einer Sitzung in Ihren Gebieten kommt eine E-Mail.",
     "start": 163.8,
     "ende": 167.3,
     "schritte": [
      {
       "szene": "kalender",
       "schritt": "abo",
       "clip": "kalender"
      }
     ]
    },
    {
     "nr": 9,
     "kern": false,
     "text": "So behalten Sie den Überblick, ohne zu suchen. Plenara meldet sich.",
