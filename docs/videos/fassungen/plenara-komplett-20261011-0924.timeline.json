    {
     "nr": 2,
     "kern": true,
     "text": "Die Seite Datenabdeckung zeigt es offen.",
     "start": 250.1,
     "ende": 252.4,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Heute sind es mehr als neunhunderttausend Einträge aus über sechstausend Gemeinden.",
     "start": 253.2,
     "ende": 257.8,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Suchen Sie Ihre Gemeinde oder Ihren Kreis und sehen Sie, wie aktuell der Stand dort ist.",
     "start": 258.6,
     "ende": 263.4,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "suche",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Auch der letzte Abruf der Daten steht dabei.",
     "start": 264.2,
     "ende": 266.8,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "abruf",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Fehlt etwas, melden Sie es uns direkt.",
     "start": 267.6,
     "ende": 270.0,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Wir sagen offen, was schon dabei ist und was noch fehlt.",
     "start": 270.8,
     "ende": 273.6,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    }
   ]
  },
  {
   "nr": 10,
   "id": "diffusion",
   "kapitel": "Sehen, wie sich ein Thema ausbreitet",
   "start": 274.7,
   "ende": 315.4,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Eine Suche zeigt einzelne Beschlüsse. Plenara X zeigt, wie sich ein Thema im ganzen Land bewegt.",
     "start": 275.2,
     "ende": 280.9,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "start",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Im Datenbestand taucht Wärmeplanung im September zweitausendfünfundzwanzig zum ersten Mal auf.",
     "start": 281.7,
     "ende": 287.3,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "karte",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Diffusionsanalyse läuft dann als Zeitraffer auf der Karte.",
     "start": 288.1,
     "ende": 291.4,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "zeitraffer",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Nach fünf Monaten war die Hälfte der Gebiete erreicht.",
     "start": 292.2,
     "ende": 295.1,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "kennzahlen",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Von zehn auf neunzig Prozent der Gebiete dauerte es elf Monate.",
     "start": 295.9,
     "ende": 299.6,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "zehnneunzig",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Das Diagramm zeigt den Verlauf Monat für Monat, ein Klick setzt die Karte auf das Datum.",
     "start": 300.4,
     "ende": 305.4,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "diagramm",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Ganz anders Hitzeschutz: Im September kamen dreihundertneunundneunzig neue Gebiete dazu.",
     "start": 306.2,
     "ende": 311.2,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "gegenbeispiel",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 8,
     "kern": false,
     "text": "Auch die Bundesländer lassen sich vergleichen.",
     "start": 312.0,
     "ende": 314.3,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "laender",
       "clip": "diffusion"
      }
     ]
    }
   ]
  },
  {
   "nr": 11,
   "id": "entscheidungen",
   "kapitel": "Wie Vorgänge ausgehen",
   "start": 315.4,
   "ende": 347.0,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Wie gehen Vorgänge aus: beschlossen, vertagt oder abgelehnt?",
     "start": 315.9,
     "ende": 319.5,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "start",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Bei Wärmeplanung sind fast fünfundneunzig Prozent der entschiedenen Vorgänge beschlossen.",
     "start": 320.3,
     "ende": 324.8,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "raten",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "vier Prozent wurden vertagt, ein Prozent abgelehnt.",
     "start": 325.6,
     "ende": 328.6,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "rateno",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Hälfte der Vorgänge war nach siebzehn Tagen entschieden.",
     "start": 329.4,
     "ende": 332.3,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "dauer",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Wo das Abstimmungsergebnis bekannt ist, waren fast neunundsechzig Prozent einstimmig.",
     "start": 333.1,
     "ende": 337.9,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "votes",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Dabei zählen nur Vorgänge mit bekanntem Status, das sind einundvierzig Prozent der Einträge. Das zeigt Plenara offen an.",
     "start": 338.7,
     "ende": 345.9,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "status",
       "clip": "entscheidungen"
      }
     ]
    }
   ]
  },
  {
   "nr": 12,
   "id": "trends",
   "kapitel": "Neues früh erkennen",
   "start": 347.0,
   "ende": 369.2,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Was kommt in Ihren Kommunen gerade auf?",
     "start": 347.5,
     "ende": 349.4,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "start",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Die Trendanalyse vergleicht die letzten neunzig Tage mit dem Zeitraum davor.",
     "start": 350.2,
     "ende": 354.1,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "zeitraum",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "In der Trendkarte ist jeder Punkt ein Begriff: rechts häufiger, oben stärker gewachsen.",
     "start": 354.9,
     "ende": 359.4,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "karte",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Rangliste zeigt zu jedem Begriff die Verlaufskurve und den Faktor des Anstiegs.",
     "start": 360.2,
     "ende": 364.7,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "rangliste",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Auch die Themenfelder lassen sich vergleichen.",
     "start": 365.5,
     "ende": 368.1,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "themenfelder",
       "clip": "trends"
      }
     ]
    }
   ]
  },
  {
   "nr": 13,
   "id": "vergleich",
   "kapitel": "Orte vergleichen",
   "start": 369.2,
   "ende": 395.9,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Wie steht Ihr Ort im Vergleich?",
     "start": 369.7,
     "ende": 371.6,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "start",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Der Gebietsvergleich stellt zwei bis vier Orte nebeneinander, hier Münster und Köln.",
     "start": 372.4,
     "ende": 377.1,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "orte",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Sie vergleichen Themenprofil, Stand der Vorlagen und aktivste Gremien.",
     "start": 377.9,
     "ende": 382.1,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "profil",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Dazu kommen typische und gemeinsame Begriffe.",
     "start": 382.9,
     "ende": 385.5,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "begriffe",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Als Maßstab dienen alle Gebiete.",
     "start": 386.3,
     "ende": 388.3,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "massstab",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Die Zahlen zeigen, was im Bestand steht, nicht automatisch, wie aktiv die Politik vor Ort ist.",
     "start": 389.1,
     "ende": 394.8,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "hinweis",
       "clip": "vergleich"
      }
     ]
    }
   ]
  },
  {
   "nr": 14,
   "id": "graph",
   "kapitel": "Zusammenhänge entdecken",
   "start": 395.9,
   "ende": 422.3,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Womit hängt Wärmeplanung zusammen?",
     "start": 396.4,
     "ende": 398.4,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "start",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Der Knowledge Graph zeigt es als Netz aus verwandten Begriffen, Themenfeldern, Gremien und Ländern.",
     "start": 399.2,
     "ende": 404.8,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "netz",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Knoten ziehen und anklicken können Sie selbst.",
     "start": 405.6,
     "ende": 408.5,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "knoten",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Auch Länder und Gremien sind Knoten, ein Klick zeigt Details.",
     "start": 409.3,
     "ende": 413.2,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "gremien",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 5,
     "kern": true,
     "text": "So entdecken Sie Zusammenhänge, nach denen Sie nie gesucht hätten.",
     "start": 414.0,
     "ende": 417.2,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "zusammenhang",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Eine Verbindung bedeutet gemeinsames Vorkommen, keine Ursache.",
     "start": 418.0,
     "ende": 421.2,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "hinweis",
       "clip": "graph"
      }
     ]
    }
   ]
  },
  {
   "nr": 15,
   "id": "gremiennetz",
   "kapitel": "Den Weg durch die Gremien verstehen",
   "start": 422.3,
   "ende": 451.8,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Welchen Weg nimmt ein Vorgang durch die Gremien?",
     "start": 422.8,
     "ende": 425.0,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "start",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Das Gremiennetz zeigt, wo Vorgänge beginnen, welche Gremien dazwischen liegen und wo sie entschieden werden.",
     "start": 425.8,
     "ende": 431.4,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "netz",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Ausgewertet sind einhundertfünfundfünfzig Vorgänge, die durch mindestens zwei Gremien gingen.",
     "start": 432.2,
     "ende": 437.3,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "pfeile",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Pfeile zeigen die Übergänge und wie lange ein Übergang dauert.",
     "start": 438.1,
     "ende": 441.4,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "dauer",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Darunter sehen Sie die Rollen im Netz: Einstieg, Durchlauf und Entscheidung.",
     "start": 442.2,
     "ende": 446.4,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "arten",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "So erkennen Sie, an welcher Stelle Sie sich in ein Thema einbringen können.",
     "start": 447.2,
     "ende": 450.7,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "fazit",
       "clip": "gremiennetz"
      }
     ]
    }
   ]
  },
  {
