     "ende": 104.0,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "exakt",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Wählen Sie Zeitraum, Thema und Status, zum Beispiel beschlossen oder in Beratung.",
     "start": 104.8,
     "ende": 109.6,
     "schritte": [
      {
       "szene": "filter-fenster",
       "schritt": "zeitraum",
       "clip": "filter-fenster"
      },
      {
       "szene": "filter-fenster",
       "schritt": "thema",
       "clip": "filter-fenster"
      },
      {
       "szene": "filter-fenster",
       "schritt": "status",
       "clip": "filter-fenster"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Karte und Liste passen sich sofort an.",
