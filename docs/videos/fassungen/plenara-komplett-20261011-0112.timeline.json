     "ende": 410.4,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "zusammenhang",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Eine Verbindung bedeutet gemeinsames Vorkommen, keine Ursache.",
