    },
    {
     "nr": 3,
     "kern": true,
     "text": "Heute sind es mehr als neunhunderttausend Einträge aus über sechstausend Gemeinden.",
     "start": 246.5,
     "ende": 251.0,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Suchen Sie Ihre Gemeinde oder Ihren Kreis und sehen Sie, wie aktuell der Stand dort ist.",
     "start": 251.8,
     "ende": 256.7,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "suche",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Auch der letzte Abruf der Daten steht dabei.",
     "start": 257.5,
     "ende": 260.1,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "abruf",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Fehlt etwas, melden Sie es uns direkt.",
     "start": 260.9,
     "ende": 263.2,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Wir sagen offen, was schon dabei ist und was noch fehlt.",
     "start": 264.0,
     "ende": 266.9,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    }
   ]
  },
  {
   "nr": 10,
   "id": "diffusion",
   "kapitel": "Sehen, wie sich ein Thema ausbreitet",
   "start": 268.0,
   "ende": 308.6,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Eine Suche zeigt einzelne Beschlüsse. Plenara X zeigt, wie sich ein Thema im ganzen Land bewegt.",
     "start": 268.5,
     "ende": 274.2,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "start",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Im Datenbestand taucht Wärmeplanung im September zweitausendfünfundzwanzig zum ersten Mal auf.",
     "start": 275.0,
     "ende": 280.6,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "karte",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Diffusionsanalyse läuft dann als Zeitraffer auf der Karte.",
     "start": 281.4,
     "ende": 284.7,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "zeitraffer",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Nach fünf Monaten war die Hälfte der Gebiete erreicht.",
     "start": 285.5,
     "ende": 288.3,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "kennzahlen",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Von zehn auf neunzig Prozent der Gebiete dauerte es elf Monate.",
     "start": 289.1,
     "ende": 292.9,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "zehnneunzig",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Das Diagramm zeigt den Verlauf Monat für Monat, ein Klick setzt die Karte auf das Datum.",
     "start": 293.7,
     "ende": 298.6,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "diagramm",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Ganz anders Hitzeschutz: Im September kamen dreihundertneunundneunzig neue Gebiete dazu.",
     "start": 299.4,
     "ende": 304.4,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "gegenbeispiel",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 8,
     "kern": false,
     "text": "Auch die Bundesländer lassen sich vergleichen.",
     "start": 305.2,
     "ende": 307.5,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "laender",
       "clip": "diffusion"
      }
     ]
    }
   ]
  },
  {
   "nr": 11,
   "id": "entscheidungen",
   "kapitel": "Wie Vorgänge ausgehen",
   "start": 308.6,
   "ende": 340.2,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Wie gehen Vorgänge aus: beschlossen, vertagt oder abgelehnt?",
     "start": 309.1,
     "ende": 312.7,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "start",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Bei Wärmeplanung sind fast fünfundneunzig Prozent der entschiedenen Vorgänge beschlossen.",
     "start": 313.5,
     "ende": 318.0,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "raten",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "vier Prozent wurden vertagt, ein Prozent abgelehnt.",
     "start": 318.8,
     "ende": 321.8,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "rateno",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Hälfte der Vorgänge war nach siebzehn Tagen entschieden.",
     "start": 322.6,
     "ende": 325.5,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "dauer",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Wo das Abstimmungsergebnis bekannt ist, waren fast neunundsechzig Prozent einstimmig.",
     "start": 326.3,
     "ende": 331.1,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "votes",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Dabei zählen nur Vorgänge mit bekanntem Status, das sind einundvierzig Prozent der Einträge. Das zeigt Plenara offen an.",
     "start": 331.9,
     "ende": 339.1,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "status",
       "clip": "entscheidungen"
      }
     ]
    }
   ]
  },
  {
   "nr": 12,
   "id": "trends",
   "kapitel": "Neues früh erkennen",
   "start": 340.2,
   "ende": 362.4,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Was kommt in Ihren Kommunen gerade auf?",
     "start": 340.7,
     "ende": 342.7,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "start",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Die Trendanalyse vergleicht die letzten neunzig Tage mit dem Zeitraum davor.",
     "start": 343.5,
     "ende": 347.4,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "zeitraum",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "In der Trendkarte ist jeder Punkt ein Begriff: rechts häufiger, oben stärker gewachsen.",
     "start": 348.2,
     "ende": 352.7,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "karte",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Rangliste zeigt zu jedem Begriff die Verlaufskurve und den Faktor des Anstiegs.",
     "start": 353.5,
     "ende": 358.0,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "rangliste",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Auch die Themenfelder lassen sich vergleichen.",
     "start": 358.8,
     "ende": 361.3,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "themenfelder",
       "clip": "trends"
      }
     ]
    }
   ]
  },
  {
   "nr": 13,
   "id": "vergleich",
   "kapitel": "Orte vergleichen",
   "start": 362.4,
   "ende": 389.2,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Wie steht Ihr Ort im Vergleich?",
     "start": 362.9,
     "ende": 364.9,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "start",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Der Gebietsvergleich stellt zwei bis vier Orte nebeneinander, hier Münster und Köln.",
     "start": 365.7,
     "ende": 370.4,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "orte",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Sie vergleichen Themenprofil, Stand der Vorlagen und aktivste Gremien.",
     "start": 371.2,
     "ende": 375.3,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "profil",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Dazu kommen typische und gemeinsame Begriffe.",
     "start": 376.1,
     "ende": 378.8,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "begriffe",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Als Maßstab dienen alle Gebiete.",
     "start": 379.6,
     "ende": 381.5,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "massstab",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Die Zahlen zeigen, was im Bestand steht, nicht automatisch, wie aktiv die Politik vor Ort ist.",
     "start": 382.3,
     "ende": 388.1,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "hinweis",
       "clip": "vergleich"
      }
     ]
    }
   ]
  },
  {
   "nr": 14,
   "id": "graph",
   "kapitel": "Zusammenhänge entdecken",
   "start": 389.2,
   "ende": 415.5,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Womit hängt Wärmeplanung zusammen?",
