     "ende": 137.2,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "konto",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Ab jetzt kommt eine E-Mail, sobald es zu Ihrer Suche neue Treffer gibt.",
     "start": 138.0,
     "ende": 141.8,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "glocke",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Wie oft Sie benachrichtigt werden, legen Sie bei jeder Suche fest.",
     "start": 142.7,
     "ende": 146.0,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "glocke",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Auch zu einem einzelnen Vorgang können Sie sich benachrichtigen lassen.",
     "start": 146.8,
     "ende": 150.3,
     "schritte": [
      {
       "szene": "alarm-artikel",
       "schritt": "glocke",
       "clip": "alarm-artikel@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Der Wochenbericht fasst alle neuen Treffer Ihrer Suchen zusammen, täglich oder an Ihrem Wunschtag.",
