     "ende": 398.0,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "netz",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Knoten ziehen und anklicken können Sie selbst.",
