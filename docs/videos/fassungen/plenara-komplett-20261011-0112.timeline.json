 "kapitel": [
  {
   "nr": 1,
   "id": "einleitung",
   "kapitel": "Wissen, was vor Ort entschieden wird, bevor es bekannt ist",
   "start": 7.2,
   "ende": 26.5,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Was entscheidet der Rat in Ihrer Gemeinde gerade über Ihre Straße, Ihre Heizung oder Ihr Geschäft?",
     "start": 7.7,
     "ende": 13.1,
     "schritte": [
      {
       "szene": "einleitung",
       "schritt": "start",
       "clip": "einleitung@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Plenara zeigt, was in Ihren Kommunen beraten wird: Beschlüsse und Beratungen an einem Ort.",
     "start": 13.9,
     "ende": 19.0,
     "schritte": [
      {
       "szene": "einleitung",
       "schritt": "karte",
       "clip": "einleitung@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Ein Begriff genügt, zum Beispiel Wärmeplanung, und die Karte zeigt sofort, wo darüber beraten wird.",
     "start": 19.8,
     "ende": 25.4,
     "schritte": [
      {
       "szene": "einleitung",
       "schritt": "suche",
       "clip": "einleitung@thema-waermeplanung"
      }
     ]
    }
   ]
  },
  {
   "nr": 2,
   "id": "suchen",
   "kapitel": "Ein Begriff. Ganz Deutschland. Sofort auf der Karte.",
   "start": 26.5,
   "ende": 59.6,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Die Suche gilt immer für ganz Deutschland. Einen Ort können Sie aber wählen.",
     "start": 27.0,
     "ende": 30.9,
     "schritte": [
      {
       "szene": "suche-eingabe",
       "schritt": "eingabe",
       "clip": "suche-eingabe@thema-waermeplanung@vorsuche-ja"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Die Karte zeigt, wo darüber beraten wird: in vierzehn Bundesländern.",
     "start": 31.7,
     "ende": 35.8,
     "schritte": [
      {
       "szene": "suche-eingabe",
       "schritt": "karte",
       "clip": "suche-eingabe@thema-waermeplanung@vorsuche-ja"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Zahl an jedem Gebiet verrät, wie viele Einträge es dort gibt.",
     "start": 36.6,
     "ende": 40.1,
     "schritte": [
      {
       "szene": "suche-eingabe",
       "schritt": "karte",
       "clip": "suche-eingabe@thema-waermeplanung@vorsuche-ja"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Ein Klick zeigt die Beschlüsse dieses Gebiets. In Stuttgart sind es dreizehn.",
     "start": 40.9,
     "ende": 44.9,
     "schritte": [
      {
       "szene": "karte-gebiet",
       "schritt": "zoom",
       "clip": "karte-gebiet@ort-stuttgart@thema-waermeplanung"
      },
      {
       "szene": "karte-gebiet",
       "schritt": "klick",
       "clip": "karte-gebiet@ort-stuttgart@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Die Heatmap zeigt auf einen Blick, wo sich ein Thema häuft.",
     "start": 45.7,
     "ende": 48.6,
     "schritte": [
      {
       "szene": "karte-heatmap",
       "schritt": "heatmap",
       "clip": "karte-heatmap@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Tippen Sie einen Ort, zum Beispiel Stuttgart, und Plenara erkennt ihn sofort.",
     "start": 49.4,
     "ende": 53.6,
     "schritte": [
      {
       "szene": "suche-ort",
       "schritt": "tippen",
       "clip": "suche-ort@ort-stuttgart"
      },
      {
       "szene": "suche-ort",
       "schritt": "ergebnis",
       "clip": "suche-ort@ort-stuttgart"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Von ganz Deutschland bis in Ihre Gemeinde. Eine Suche, eine Karte.",
     "start": 54.4,
     "ende": 58.5,
     "schritte": [
      {
       "szene": "suche-ort",
       "schritt": "ergebnis",
       "clip": "suche-ort@ort-stuttgart"
      }
     ]
    }
   ]
  },
  {
   "nr": 3,
   "id": "liste-artikel",
   "kapitel": "Aus über zehntausend Einträgen den Überblick behalten",
   "start": 59.6,
   "ende": 96.7,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Zu einem Thema gibt es mehr als zweitausend Einträge, jeder mit Gremium und Datum.",
     "start": 60.1,
     "ende": 65.2,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "liste",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Jede Zeile sagt Ihnen, worum es geht, wer berät und wann.",
     "start": 66.0,
     "ende": 69.8,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "zeile",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Bei vielen Vorgängen sehen Sie sogar den Stand: jede Beratung mit Datum und Gremium.",
     "start": 70.6,
     "ende": 75.5,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "zeitstrahl",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Sortieren Sie nach Datum oder Relevanz, kompakt oder ausführlich.",
     "start": 76.3,
     "ende": 80.5,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "liste",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Ein Klick öffnet den ganzen Artikel.",
     "start": 81.3,
     "ende": 83.3,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "artikel",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Eine Kurzfassung unter dem Titel sagt Ihnen sofort, worum es geht.",
     "start": 84.1,
     "ende": 87.8,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "artikel",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Darunter stehen der Verlauf durch die Gremien und alle Unterlagen.",
     "start": 88.6,
     "ende": 91.8,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "verlauf",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 8,
     "kern": false,
     "text": "Vom Überblick zur Originalunterlage in wenigen Klicks.",
     "start": 92.6,
     "ende": 95.6,
     "schritte": [
      {
       "szene": "liste-zeitstrahl",
       "schritt": "quelle",
       "clip": "liste-zeitstrahl@thema-waermeplanung"
      }
     ]
    }
   ]
  },
  {
   "nr": 4,
   "id": "filter",
   "kapitel": "Gezielt eingrenzen, bis nur das Passende übrig bleibt",
   "start": 96.7,
   "ende": 128.7,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Zu viele Treffer? Dann grenzen Sie sie ein.",
