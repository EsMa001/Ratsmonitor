  {
   "nr": 15,
   "id": "gremiennetz",
   "kapitel": "Den Weg durch die Gremien verstehen",
   "start": 415.5,
   "ende": 445.0,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Welchen Weg nimmt ein Vorgang durch die Gremien?",
     "start": 416.0,
     "ende": 418.2,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "start",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Das Gremiennetz zeigt, wo Vorgänge beginnen, welche Gremien dazwischen liegen und wo sie entschieden werden.",
     "start": 419.0,
     "ende": 424.6,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "netz",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Ausgewertet sind einhundertfünfundfünfzig Vorgänge, die durch mindestens zwei Gremien gingen.",
     "start": 425.4,
     "ende": 430.5,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "pfeile",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Pfeile zeigen die Übergänge und wie lange ein Übergang dauert.",
     "start": 431.3,
     "ende": 434.6,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "dauer",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Darunter sehen Sie die Rollen im Netz: Einstieg, Durchlauf und Entscheidung.",
     "start": 435.4,
     "ende": 439.7,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "arten",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "So erkennen Sie, an welcher Stelle Sie sich in ein Thema einbringen können.",
     "start": 440.5,
     "ende": 443.9,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "fazit",
       "clip": "gremiennetz"
      }
     ]
    }
   ]
  },
