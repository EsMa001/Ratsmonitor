     "ende": 134.7,
     "schritte": [
      {
       "szene": "alarm",
       "schritt": "herz",
       "clip": "alarm@thema-waermeplanung"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Im Konto schalten Sie die Glocke ein.",
