 "kapitel": [
  {
   "nr": 1,
   "id": "einleitung",
   "kapitel": "Wissen, was vor Ort entschieden wird, bevor es bekannt ist",
   "start": 7.2,
   "ende": 38.2,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Was wird in Räten gerade beraten, das Ihr Vorhaben, Ihre Stadt oder Ihre Recherche betrifft?",
     "start": 7.7,
     "ende": 12.6,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "kopf",
       "clip": "startseite"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Plenara zeigt, was in Ihren Kommunen beraten wird: Beschlüsse und Beratungen an einem Ort.",
     "start": 13.4,
     "ende": 18.5,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "marke",
       "clip": "startseite"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Zahl zeigt, wie viele Berichte aus Räten und Ausschüssen in den letzten 30 Tagen dazugekommen sind.",
     "start": 19.3,
     "ende": 25.2,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "zahl",
       "clip": "startseite"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Ein Begriff genügt, zum Beispiel Wärmeplanung, und die Karte zeigt sofort, wo darüber beraten wird.",
     "start": 26.0,
     "ende": 31.7,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "suche",
       "clip": "startseite"
      }
     ]
    },
    {
     "nr": 5,
     "kern": true,
     "text": "Jede Angabe führt zur Originalunterlage, und Alarme melden Neues per E-Mail.",
     "start": 32.5,
     "ende": 37.1,
     "schritte": [
      {
       "szene": "startseite",
       "schritt": "artikel",
       "clip": "startseite"
      }
     ]
    }
   ]
  },
  {
   "nr": 2,
   "id": "suchen",
   "kapitel": "Ein Begriff. Ganz Deutschland. Sofort auf der Karte.",
   "start": 38.2,
   "ende": 71.3,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Die Suche gilt immer für ganz Deutschland. Einen Ort können Sie aber wählen.",
