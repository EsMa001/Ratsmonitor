   "ende": 279.7,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Ist Ihre Gemeinde dabei?",
     "start": 252.7,
     "ende": 254.3,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Die Seite Datenabdeckung zeigt es offen.",
     "start": 255.1,
     "ende": 257.4,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Heute sind es mehr als neunhunderttausend Einträge aus über sechstausend Gemeinden.",
     "start": 258.2,
     "ende": 262.7,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "seite",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Suchen Sie Ihre Gemeinde oder Ihren Kreis und sehen Sie, wie aktuell der Stand dort ist.",
     "start": 263.5,
     "ende": 268.4,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "suche",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Auch der letzte Abruf der Daten steht dabei.",
     "start": 269.2,
     "ende": 271.8,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "abruf",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Fehlt etwas, melden Sie es uns direkt.",
     "start": 272.6,
     "ende": 274.9,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Wir sagen offen, was schon dabei ist und was noch fehlt.",
     "start": 275.7,
     "ende": 278.6,
     "schritte": [
      {
       "szene": "abdeckung",
       "schritt": "melden",
       "clip": "abdeckung"
      }
     ]
    }
   ]
  },
  {
   "nr": 10,
   "id": "diffusion",
   "kapitel": "Sehen, wie sich ein Thema ausbreitet",
   "start": 279.7,
   "ende": 320.3,
   "saetze": [
    {
     "nr": 1,
     "kern": true,
     "text": "Eine Suche zeigt einzelne Beschlüsse. Plenara X zeigt, wie sich ein Thema im ganzen Land bewegt.",
     "start": 280.2,
     "ende": 285.8,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "start",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Im Datenbestand taucht Wärmeplanung im September zweitausendfünfundzwanzig zum ersten Mal auf.",
     "start": 286.6,
     "ende": 292.3,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "karte",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Diffusionsanalyse läuft dann als Zeitraffer auf der Karte.",
     "start": 293.1,
     "ende": 296.4,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "zeitraffer",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Nach fünf Monaten war die Hälfte der Gebiete erreicht.",
     "start": 297.2,
     "ende": 300.0,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "kennzahlen",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Von zehn auf neunzig Prozent der Gebiete dauerte es elf Monate.",
     "start": 300.8,
     "ende": 304.6,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "zehnneunzig",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Das Diagramm zeigt den Verlauf Monat für Monat, ein Klick setzt die Karte auf das Datum.",
     "start": 305.4,
     "ende": 310.3,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "diagramm",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 7,
     "kern": false,
     "text": "Ganz anders Hitzeschutz: Im September kamen dreihundertneunundneunzig neue Gebiete dazu.",
     "start": 311.1,
     "ende": 316.1,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "gegenbeispiel",
       "clip": "diffusion"
      }
     ]
    },
    {
     "nr": 8,
     "kern": false,
     "text": "Auch die Bundesländer lassen sich vergleichen.",
     "start": 316.9,
     "ende": 319.2,
     "schritte": [
      {
       "szene": "diffusion",
       "schritt": "laender",
       "clip": "diffusion"
      }
     ]
    }
   ]
  },
  {
   "nr": 11,
   "id": "entscheidungen",
   "kapitel": "Wie Vorgänge ausgehen",
   "start": 320.3,
   "ende": 351.9,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Wie gehen Vorgänge aus: beschlossen, vertagt oder abgelehnt?",
     "start": 320.8,
     "ende": 324.4,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "start",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Bei Wärmeplanung sind fast fünfundneunzig Prozent der entschiedenen Vorgänge beschlossen.",
     "start": 325.2,
     "ende": 329.7,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "raten",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "vier Prozent wurden vertagt, ein Prozent abgelehnt.",
     "start": 330.5,
     "ende": 333.5,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "rateno",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Hälfte der Vorgänge war nach siebzehn Tagen entschieden.",
     "start": 334.3,
     "ende": 337.2,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "dauer",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Wo das Abstimmungsergebnis bekannt ist, waren fast neunundsechzig Prozent einstimmig.",
     "start": 338.0,
     "ende": 342.8,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "votes",
       "clip": "entscheidungen"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Dabei zählen nur Vorgänge mit bekanntem Status, das sind einundvierzig Prozent der Einträge. Das zeigt Plenara offen an.",
     "start": 343.6,
     "ende": 350.8,
     "schritte": [
      {
       "szene": "entscheidungen",
       "schritt": "status",
       "clip": "entscheidungen"
      }
     ]
    }
   ]
  },
  {
   "nr": 12,
   "id": "trends",
   "kapitel": "Neues früh erkennen",
   "start": 351.9,
   "ende": 374.1,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Was kommt in Ihren Kommunen gerade auf?",
     "start": 352.4,
     "ende": 354.4,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "start",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 2,
     "kern": false,
     "text": "Die Trendanalyse vergleicht die letzten neunzig Tage mit dem Zeitraum davor.",
     "start": 355.2,
     "ende": 359.0,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "zeitraum",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "In der Trendkarte ist jeder Punkt ein Begriff: rechts häufiger, oben stärker gewachsen.",
     "start": 359.8,
     "ende": 364.4,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "karte",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Rangliste zeigt zu jedem Begriff die Verlaufskurve und den Faktor des Anstiegs.",
     "start": 365.2,
     "ende": 369.6,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "rangliste",
       "clip": "trends"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Auch die Themenfelder lassen sich vergleichen.",
     "start": 370.4,
     "ende": 373.0,
     "schritte": [
      {
       "szene": "trends",
       "schritt": "themenfelder",
       "clip": "trends"
      }
     ]
    }
   ]
  },
  {
   "nr": 13,
   "id": "vergleich",
   "kapitel": "Orte vergleichen",
   "start": 374.1,
   "ende": 400.9,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Wie steht Ihr Ort im Vergleich?",
     "start": 374.6,
     "ende": 376.6,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "start",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Der Gebietsvergleich stellt zwei bis vier Orte nebeneinander, hier Münster und Köln.",
     "start": 377.4,
     "ende": 382.1,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "orte",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 3,
     "kern": true,
     "text": "Sie vergleichen Themenprofil, Stand der Vorlagen und aktivste Gremien.",
     "start": 382.9,
     "ende": 387.0,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "profil",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Dazu kommen typische und gemeinsame Begriffe.",
     "start": 387.8,
     "ende": 390.5,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "begriffe",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Als Maßstab dienen alle Gebiete.",
     "start": 391.3,
     "ende": 393.2,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "massstab",
       "clip": "vergleich"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Die Zahlen zeigen, was im Bestand steht, nicht automatisch, wie aktiv die Politik vor Ort ist.",
     "start": 394.0,
     "ende": 399.8,
     "schritte": [
      {
       "szene": "vergleich",
       "schritt": "hinweis",
       "clip": "vergleich"
      }
     ]
    }
   ]
  },
  {
   "nr": 14,
   "id": "graph",
   "kapitel": "Zusammenhänge entdecken",
   "start": 400.9,
   "ende": 427.2,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Womit hängt Wärmeplanung zusammen?",
     "start": 401.4,
     "ende": 403.3,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "start",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Der Knowledge Graph zeigt es als Netz aus verwandten Begriffen, Themenfeldern, Gremien und Ländern.",
     "start": 404.1,
     "ende": 409.7,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "netz",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Die Knoten ziehen und anklicken können Sie selbst.",
     "start": 410.5,
     "ende": 413.4,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "knoten",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 4,
     "kern": false,
     "text": "Auch Länder und Gremien sind Knoten, ein Klick zeigt Details.",
     "start": 414.2,
     "ende": 418.1,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "gremien",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 5,
     "kern": true,
     "text": "So entdecken Sie Zusammenhänge, nach denen Sie nie gesucht hätten.",
     "start": 418.9,
     "ende": 422.1,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "zusammenhang",
       "clip": "graph"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "Eine Verbindung bedeutet gemeinsames Vorkommen, keine Ursache.",
     "start": 422.9,
     "ende": 426.1,
     "schritte": [
      {
       "szene": "graph",
       "schritt": "hinweis",
       "clip": "graph"
      }
     ]
    }
   ]
  },
  {
   "nr": 15,
   "id": "gremiennetz",
   "kapitel": "Den Weg durch die Gremien verstehen",
   "start": 427.2,
   "ende": 456.7,
   "saetze": [
    {
     "nr": 1,
     "kern": false,
     "text": "Welchen Weg nimmt ein Vorgang durch die Gremien?",
     "start": 427.7,
     "ende": 429.9,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "start",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 2,
     "kern": true,
     "text": "Das Gremiennetz zeigt, wo Vorgänge beginnen, welche Gremien dazwischen liegen und wo sie entschieden werden.",
     "start": 430.7,
     "ende": 436.3,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "netz",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 3,
     "kern": false,
     "text": "Ausgewertet sind einhundertfünfundfünfzig Vorgänge, die durch mindestens zwei Gremien gingen.",
     "start": 437.1,
     "ende": 442.2,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "pfeile",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 4,
     "kern": true,
     "text": "Die Pfeile zeigen die Übergänge und wie lange ein Übergang dauert.",
     "start": 443.0,
     "ende": 446.3,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "dauer",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 5,
     "kern": false,
     "text": "Darunter sehen Sie die Rollen im Netz: Einstieg, Durchlauf und Entscheidung.",
     "start": 447.1,
     "ende": 451.4,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "arten",
       "clip": "gremiennetz"
      }
     ]
    },
    {
     "nr": 6,
     "kern": false,
     "text": "So erkennen Sie, an welcher Stelle Sie sich in ein Thema einbringen können.",
     "start": 452.2,
     "ende": 455.6,
     "schritte": [
      {
       "szene": "gremiennetz",
       "schritt": "fazit",
       "clip": "gremiennetz"
      }
     ]
    }
   ]
  },
  {
